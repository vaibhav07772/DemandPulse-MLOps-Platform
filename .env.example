# Environment: development | staging | production
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# App
APP_NAME=DemandPulse AI
APP_VERSION=1.2.0

# Uploads
MAX_UPLOAD_BYTES=52428800
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls

# Forecasting
ALLOWED_HORIZONS=7,30,60,90
MAX_CACHED_MODELS=2

# MLflow (Phase 2)
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=demandpulse-forecasting
MLFLOW_REGISTERED_MODEL_NAME=demandpulse-forecaster
MLFLOW_AUTO_REGISTER=true
